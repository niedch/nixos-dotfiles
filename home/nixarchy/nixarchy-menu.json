    },
    "converter": {
      "enabled": true,
      "timezone": ""
    },
    "colors": {
      "enabled": true,
      "format": "hex"
    },
    "emoji": {
      "enabled": true
    },
    "clipboard": {
      "enabled": true,
      "limit": 100
    },
    "files": {
      "enabled": true,
      "searchMode": "fuzzy",
      "files": true,
      "folders": true,
      "hidden": false,
      "limit": 10
