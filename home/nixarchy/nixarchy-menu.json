{
  "version": 1,
  "palette": {
    "density": "compact",
    "accent": "theme",
    "showPreview": true,
    "animations": "snappy",
    "windowTransition": "instant"
  },
  "voice": {
    "enabled": false,
    "secondTap": "voice",
