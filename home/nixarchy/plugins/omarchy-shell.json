{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "left": [
        {
          "id": "nixarchy.menu"
        },
        {
          "id": "jgarza.workspace-styles",
          "count": 5,
          "decoration": "underline",
          "animation": "none",
          "glyphSet": "kanji",
          "indicatorColor": "muted"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "tmn73.calendar",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "crmne.mpris"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.nobledoodle.omarchroma"
        },
        {
          "id": "nixarchy.rebuild"
        },
        {
          "id": "io.github.olafkfreund.nixarchy-plugin-browser"
        },
        {
          "id": "nixarchy.pkg"
        },
        {
          "id": "nixarchy.microvm"
        },
        {
          "id": "olafkfreund.ai-mirror"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "nic.numr"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "io.github.olafkfreund.nixi"
    },
    {
      "id": "nixarchy.flatsnap"
    },
    {
      "id": "olafkfreund.github-actions"
    },
    {
      "id": "olafkfreund.gitlab-pipelines"
    },
    {
      "id": "aziz.hyprforge"
    },
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "poster"
    }
  ],
  "cloneSourceRestores": ["nixarchy.menu", "io.github.sirjul1337.lock-explorer"],
  "disabledPlugins": ["omarchy.menu", "omarchy.lock"]
}
