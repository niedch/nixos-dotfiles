--!nonstrict
local common = {}

common.STATE_KEY = "presentation_mode_status"
common.GHOSTTY_CONF_PATH = noctalia.expandPath("~/.config/ghostty/presentation.conf")
common.GHOSTTY_DIR = noctalia.expandPath("~/.config/ghostty")

function common.isActive(): boolean
    local state = noctalia.state.get(common.STATE_KEY)
    if state ~= nil and type(state) == "table" and state.active ~= nil then
        return state.active == true
    end
    return noctalia.fileExists(common.GHOSTTY_CONF_PATH)
end

function common.setPresentationMode(enable: boolean)
    local textScale = tostring(noctalia.getConfig("text_scaling_factor") or "1.25")
    local fontSize = noctalia.getConfig("ghostty_font_size") or 14
    local inhibitIdle = noctalia.getConfig("inhibit_idle")
    if inhibitIdle == nil then inhibitIdle = true end
    local enableDnd = noctalia.getConfig("enable_dnd")
    if enableDnd == nil then enableDnd = true end

    if enable then
        -- 1. Create Ghostty override file (disable transparency and increase font size)
        noctalia.mkdirAll(common.GHOSTTY_DIR)
        local ghosttyConfig = "# Auto-generated by Noctalia Presentation Mode\nbackground-opacity = 1.0\nfont-size = " .. tostring(fontSize) .. "\n"
        noctalia.writeFile(common.GHOSTTY_CONF_PATH, ghosttyConfig)
        noctalia.runAsync("pkill -SIGUSR2 ghostty")

        -- 2. Increase GTK / system font scaling factor
        noctalia.runAsync("gsettings set org.gnome.desktop.interface text-scaling-factor " .. textScale)

        -- 3. Increase Noctalia UI scale
        noctalia.runAsync("noctalia msg config-set accessibility.ui_scale " .. textScale)

        -- 4. Inhibit idle / sleep via Noctalia caffeine
        if inhibitIdle then
            noctalia.runAsync("noctalia msg caffeine-enable")
        end

        -- 5. Silence notifications via Noctalia DND
        if enableDnd then
            noctalia.runAsync("noctalia msg notification-dnd-set on")
        end

        -- 6. OSD HUD feedback
        noctalia.osd.show("presentation", noctalia.tr("osd.enabled"))
    else
        -- 1. Remove Ghostty override file and reload Ghostty
        if noctalia.fileExists(common.GHOSTTY_CONF_PATH) then
            noctalia.removeFile(common.GHOSTTY_CONF_PATH)
        end
        noctalia.runAsync("pkill -SIGUSR2 ghostty")

        -- 2. Reset GTK / system font scaling factor
        noctalia.runAsync("gsettings reset org.gnome.desktop.interface text-scaling-factor")

        -- 3. Reset Noctalia UI scale
        noctalia.runAsync("noctalia msg config-set accessibility.ui_scale 1.0")

        -- 4. Restore idle / sleep
        if inhibitIdle then
            noctalia.runAsync("noctalia msg caffeine-disable")
        end

        -- 5. Restore notifications
        if enableDnd then
            noctalia.runAsync("noctalia msg notification-dnd-set off")
        end

        -- 6. OSD HUD feedback
        noctalia.osd.show("presentation-off", noctalia.tr("osd.disabled"), { inactive = true })
    end

    -- Update shared state across all entry runtimes
    noctalia.state.set(common.STATE_KEY, { active = enable })
end

function common.toggle()
    local current = common.isActive()
    common.setPresentationMode(not current)
end

return common
