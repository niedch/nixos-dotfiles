{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  // ----------------------------- Permissions -----------------------------
  "permission": {
    "external_directory": {
      "~/Projects/**": "allow",
      "/nix/**": "allow"
    }
  },
  // ------------------------------- Modes -------------------------------
  "agent": {
    "build": {
      "mode": "primary",
      "model": "google/gemini-3.5-flash"
    },
    "orchestrator": {
      "mode": "primary",
      "model": "google/gemini-3.5-flash",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "allow",
        "todowrite": "allow",
        "question": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "google/gemini-3.5-flash",
      "permission": {
        "edit": "deny"
      }
    },
  // ------------------------------- Agents -------------------------------
    "explore": {
      "description": "Fast agent specialized for exploring codebases and answering search questions",
      "model": "google/gemini-3.5-flash",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "todowrite": "deny"
      }
    },
    "general": {
      "model": "google/gemini-3.5-flash"
    },
    "researcher": {
      "description": "Explores code structure and answers architecture questions (read-only)",
      "mode": "subagent",
      "model": "google/gemini-3.5-flash",
      "prompt": "{file:./prompts/researcher.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "todowrite": "deny"
      }
    },
    "builder": {
      "description": "Implements code changes based on research findings",
      "mode": "subagent",
      "model": "google/gemini-3.5-flash",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "todowrite": "deny"
      }
    },
    "willhaben-agent": {
      "description": "Searches willhaben.at for best deals based on user criteria",
      "mode": "subagent",
      "model": "google/gemini-3.5-flash",
      "prompt": "{file:./prompts/willhaben-agent.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "todowrite": "deny"
      }
    },
    "pr-summarizer": {
      "description": "Summarizes GitHub pull request comments using gh CLI and gemini-3.5-flash",
      "mode": "subagent",
      "model": "google/gemini-3.5-flash",
      "prompt": "{file:./prompts/pr-summarizer.md}",
      "permission": {
        "edit": "deny",
        "todowrite": "deny"
      }
    }
  }
}
