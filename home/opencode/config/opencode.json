{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash"
    },
    "hard-plan": {
      "mode": "primary",
      "model": "opencode-go/glm-5.1"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "permission": {
        "edit": "deny"
      }
    },
    "explore": {
      "description": "Fast agent specialized for exploring codebases and answering search questions",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "todowrite": "deny"
      }
    },
    "general": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "researcher": {
      "description": "Explores code structure and answers architecture questions (read-only)",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/researcher.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "todowrite": "deny"
      }
    },
    "willhaben-agent": {
      "description": "Searches willhaben.at for best deals based on user criteria",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/willhaben-agent.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "todowrite": "deny"
      }
    },
    "pr-summarizer": {
      "description": "Summarizes GitHub pull request comments using gh CLI and deepseek-v4-flash",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/pr-summarizer.md}",
      "permission": {
        "edit": "deny",
        "todowrite": "deny"
      }
    }
  }
}
