{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "default_agent": "plan",
  "lsp": true,
  "experimental": {
    "todo": true
  },
  // ----------------------------- Providers -------------------------------
  "providers": {
    "opencode-go": {
      "settings": {
        "apiKey": "{env:OPENCODE_GO}"
      }
    }
  },
  // ----------------------------- Permissions -----------------------------
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/Projects/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/nix/*",
      "effect": "allow"
    }
  ],
  // ------------------------------- Modes & Agents ------------------------
  "agents": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro"
    },
    "orchestrator": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "system": "{file:./prompts/orchestrator.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "explore": {
      "description": "Fast agent specialized for exploring codebases and answering search questions",
      "model": "opencode-go/deepseek-v4.1-flash",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "researcher": {
      "description": "Explores code structure and answers architecture questions (read-only)",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "{file:./prompts/researcher.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    },
    "builder": {
      "description": "Implements code changes based on research findings",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    },
    "willhaben-agent": {
      "description": "Searches willhaben.at for best deals based on user criteria",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "{file:./prompts/willhaben-agent.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    },
    "ams-agent": {
      "description": "Searches Austrian AMS (jobs.ams.at) for job openings based on user criteria",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "{file:./prompts/ams-agent.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    },
    "kununu-agent": {
      "description": "Researches Austrian companies, employee reviews, salaries, and workplace culture on kununu.com/at",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "{file:./prompts/kununu-agent.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    },
    "pr-summarizer": {
      "description": "Summarizes GitHub pull request comments using gh CLI and deepseek-v4-flash",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "system": "{file:./prompts/pr-summarizer.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
